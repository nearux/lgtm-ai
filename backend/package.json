{
  "name": "@lgtmai/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./types": {
      "types": "./types/index.ts",
      "import": "./dist/types/index.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "codegen": "graphql-codegen --config codegen.ts",
    "build": "pnpm codegen && tsoa routes && node esbuild.config.mjs",
    "dev": "dotenv -e ../.env -c -- sh -c 'prisma migrate dev && tsoa spec && tsoa routes && (tsx watch --loader ./gql-loader.mjs index.ts || true)'",
    "start": "prisma migrate deploy && node dist/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@tsoa/runtime": "7.0.0-alpha.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "http-status": "^2.1.0",
    "inversify": "^8.1.0",
    "reflect-metadata": "^0.2.2",
    "remeda": "^2.33.4",
    "tsoa": "^7.0.0-alpha.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/schema-ast": "^5.0.2",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^18.19.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "graphql": "^16.13.2",
    "prisma": "^7.4.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  }
}
