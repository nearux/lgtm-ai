generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum ChatSessionScopeType {
  REVIEW
  COMMENT
  PR
  ISSUE
}

enum ChatSessionTargetType {
  PR
  ISSUE
}

model Project {
  id          String  @id
  name        String
  description String?
  working_dir String
  created_at  DateTime
  updated_at  DateTime
}

model ChatSession {
  id                String                @id
  project_id        String
  target_type       ChatSessionTargetType
  target_number     Int
  scope_type        ChatSessionScopeType
  scope_target_id   String
  claude_session_id String                @unique
  title             String?
  command           String?
  custom_prompt     String?
  created_at        DateTime
  updated_at        DateTime
  last_used_at      DateTime

  @@index([project_id, target_type, target_number])
  @@index([project_id, target_type, target_number, scope_type, scope_target_id])
}
