{
  "name": "lgtmai",
  "version": "0.1.0",
  "description": "Auto-apply PR reviews with Claude Code",
  "main": "cli/dist/index.js",
  "types": "cli/dist/index.d.ts",
  "bin": {
    "lgtmai": "./bin/lgtmai.js"
  },
  "scripts": {
    "build": "pnpm --filter @lgtmai/cli build && pnpm --filter @lgtmai/backend build && pnpm --filter frontend build",
    "dev": "concurrently --kill-others-on-fail \"PORT=5051 pnpm --filter '@lgtmai/backend' run dev\" \"wait-on http://localhost:5051/health && pnpm --filter 'frontend' run dev\"",
    "start": "node bin/lgtmai.js",
    "test": "pnpm --filter '*' --if-present run test",
    "lint": "pnpm --filter '*' --if-present run lint",
    "lint:fix": "pnpm --filter '*' --if-present run lint:fix",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "cli",
    "claude",
    "code-review",
    "github",
    "pr",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nearux/lgtm-ai"
  },
  "files": [
    "cli/dist/index.js",
    "backend/dist/index.js",
    "backend/prisma/schema.prisma",
    "frontend/dist",
    "bin"
  ],
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "signal-exit": "3.0.7"
    }
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "prisma": "^7.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "wait-on": "^9.0.4"
  }
}
